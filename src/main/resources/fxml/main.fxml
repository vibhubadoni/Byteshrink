<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.byteshrink.MainController"
      spacing="0"
      styleClass="main-container">

    <!-- Top Navigation Bar -->
    <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="20">
        <Label text="Byteshrink" styleClass="navbar-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Home" styleClass="navbar-btn" />
            <Button text="Features" styleClass="navbar-btn" />
            <Button text="Pricing" styleClass="navbar-btn" />
            <Button text="Contact" styleClass="navbar-btn" />
        </HBox>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="getStartedButton" text="Get Started" styleClass="get-started-btn" />
    </HBox>

    <!-- Main Title and Subtitle -->
    <VBox alignment="CENTER" spacing="5" styleClass="hero-section">
        <Label text="Byteshrink" styleClass="hero-title"/>
        <Label text="Compress text and images efficiently with advanced Huffman encoding" styleClass="hero-subtitle"/>
    </VBox>

    <!-- Section Tabs -->


    <!-- Main Cards: Text and Image Compression -->
    <HBox alignment="CENTER" spacing="60" styleClass="main-cards">
        <VBox alignment="CENTER" spacing="10">
            <ImageView fx:id="textImageButton" fitWidth="260" fitHeight="260" pickOnBounds="true" onMouseClicked="#handleTextImageClick" preserveRatio="true">
                <image>
                    <Image url="@/images/text_placeholder.png" />
                </image>
            </ImageView>
            <Label text="Text Compression" styleClass="card-title" />
        </VBox>
        <VBox alignment="CENTER" spacing="10">
            <ImageView fx:id="imageImageButton" fitWidth="260" fitHeight="260" pickOnBounds="true" onMouseClicked="#handleImageImageClick" preserveRatio="true">
                <image>
                    <Image url="@/images/image_placeholder.png" />
                </image>
            </ImageView>
            <Label text="Image Compression" styleClass="card-title" />
        </VBox>
    </HBox>
    <HBox alignment="CENTER" spacing="15" styleClass="section-tabs">

        <ToggleButton fx:id="analyticsTabButton" text="Analytics" styleClass="section-tab-btn" />
        <ToggleButton fx:id="visualizerTabButton" text="visualizer" styleClass="section-tab-btn" />
    </HBox>

    <!-- Why Choose Section -->
    <HBox alignment="CENTER" spacing="20" styleClass="why-section">
        <VBox alignment="CENTER" styleClass="why-card">
            <Label text="⚡" styleClass="why-icon" />
            <Label text="Lightning Fast" styleClass="why-title" />
            <Label text="Optimized algorithms for quick compression without quality loss" styleClass="why-desc" />
        </VBox>
        <VBox alignment="CENTER" styleClass="why-card">
            <Label text="🛡️" styleClass="why-icon" />
            <Label text="Lossless Quality" styleClass="why-title" />
            <Label text="Perfect reconstruction of original data with no quality degradation" styleClass="why-desc" />
        </VBox>
        <VBox alignment="CENTER" styleClass="why-card">
            <Label text="📈" styleClass="why-icon" />
            <Label text="High Efficiency" styleClass="why-title" />
            <Label text="Achieve optimal compression ratios with variable-length encoding" styleClass="why-desc" />
        </VBox>
    </HBox>

    <!-- Footer -->
    <HBox alignment="CENTER" styleClass="footer">
        <Label text="CompressHub" styleClass="footer-title" />
        <Label text="Efficient compression solutions powered by Huffman encoding" styleClass="footer-desc" />
    </HBox>

</VBox>